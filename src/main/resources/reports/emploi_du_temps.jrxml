                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{horaire}]]></textFieldExpression>
            </textField>
            
            <!-- Lundi -->
            <textField isBlankWhenNull="true">
                <reportElement mode="Opaque" x="80" y="0" width="120" height="45"/>
                <box topPadding="2" leftPadding="3" bottomPadding="2" rightPadding="3">
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{lundi}]]></textFieldExpression>
            </textField>
            
            <!-- Mardi -->
            <textField isBlankWhenNull="true">
                <reportElement mode="Opaque" x="200" y="0" width="120" height="45"/>
