# Configuration Base de données
DB_URL=jdbc:mysql://localhost:3306/parent_portal?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Configuration JWT
JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits
JWT_EXPIRATION=86400000

# Configuration SMS
SMS_PROVIDER=console
SMS_SENDER_ID=IUSJ

# Configuration Twilio (optionnel)
SMS_TWILIO_ACCOUNT_SID=your_twilio_account_sid
SMS_TWILIO_AUTH_TOKEN=your_twilio_auth_token
SMS_TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Configuration Africa's Talking (optionnel)
SMS_AFRICASTALKING_USERNAME=your_africastalking_username
SMS_AFRICASTALKING_API_KEY=your_africastalking_api_key

# Configuration OTP
OTP_EXPIRATION_MINUTES=15
OTP_LENGTH=6
